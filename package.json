{
  "name": "tape-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:policies",
    "test:unit": "vitest run --project unit",
    "test:policies": "node scripts/db/with-test-db.mjs vitest run --project policies",
    "db:reset": "node scripts/db/apply.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:dashes && npm test",
    "db:invite": "node scripts/db/invite.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "pg": "8.16.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
