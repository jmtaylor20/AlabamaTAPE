# Copy to .env.local for local development. Never commit real values.

# Public: safe to ship to the browser. Row-level security protects the data, not these keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Used by server actions and scheduled jobs. Never exposed to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Local Postgres used by the policy test suite (scripts/db/with-test-db.mjs sets this automatically).
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/tape_test
